includes:
  - vendor/mspirkov/yii2-phpstan/extension.neon

parameters:
  level: max
  ignoreErrors:
    - identifier: missingType.iterableValue
    -
      message: '#^Call to an undefined static method Dom\\HTMLDocument::createFromString\(\)\.$#'
      identifier: staticMethod.notFound
      reportUnmatched: false
      path: commands/PhpController.php
    -
      message: '#^Access to an undefined property Dom\\Element::\$textContent\.$#'
      identifier: property.notFound
      reportUnmatched: false
      path: commands/PhpController.php

    # TODO: remove after updating Yii2 to 2.0.56.
    -
      message: '#^Widget option "scrollTo" for yii\\widgets\\Pjax must be bool\|int, yii\\web\\JsExpression given\.$#'
      identifier: mspirkovYii2.widgetPropertiesValidation
    -
      message: '#^Object option "pagination" for yii\\data\\ActiveDataProvider must be yii\\data\\Pagination\|false, array<string, string> given\.$#'
      identifier: mspirkovYii2.yiiCreateObjectValidation

  paths:
    - ./

  excludePaths:
    - data
    - deploy.php
    - node_modules
    - runtime
    - tests
    - vendor

  tmpDir: runtime/phpstan

  bootstrapFiles:
    - vendor/yiisoft/yii2/Yii.php

  mspirkovYii2:
    enableAllRules: false
    enableValidationRules: true
    aliases:
      '@app': .
    yiiAppTypes:
      -
        paths:
          - widgets/Icon.php
        type: yii\web\Application
        nullable: true
      -
        paths:
          - actions
          - assets
          - controllers
          - views
          - widgets
          - helpers/ApplicationLanguage.php
          - formatters/CompressiveHtmlResponseFormatter.php
        type: yii\web\Application
        nullable: false
      -
        paths:
          - commands
        type: yii\console\Application
        nullable: false
      -
        paths:
          - .
        type: yii\console\Application|yii\web\Application
        nullable: false
    applicationConfigs:
      -
        paths:
          - .
        files:
          - config/web.php
      -
        paths:
          - commands
        files:
          - config/console.php
